# --- Obbligatorie -------------------------------------------------------------
# Dominio (o sottodominio) puntato all'IP del server, es. officina.boffbike.it
DOMINIO=officina.example.com
# Password del database: lunga e casuale (es. openssl rand -hex 24)
DB_PASSWORD=cambiami
# Segreto per "resta collegato" (es. openssl rand -hex 32)
BOFF_REMEMBER_ME_KEY=cambiami
# Primo accesso del titolare (creato solo al primo avvio)
BOFF_TITOLARE_EMAIL=titolare@example.com
BOFF_TITOLARE_PASSWORD=cambiami-subito
BOFF_TITOLARE_NOME=Nome
BOFF_TITOLARE_COGNOME=Cognome

# --- Negozio ------------------------------------------------------------------
BOFF_NOME_NEGOZIO=Boff Bike
BOFF_EMAIL_MITTENTE=officina@example.com
# false se il negozio apre nei giorni festivi del Canton Grigioni
BOFF_FESTIVI_CHIUSI=true

# --- Email (consigliata: recupero password e avviso "bici pronta") -------------
# Senza queste righe le email non partono (vengono solo scritte nel log).
#SPRING_MAIL_HOST=smtp.example.com
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=utente
#SPRING_MAIL_PASSWORD=password
